# Google Gemini API Key for Server-Side AI Assistant
GEMINI_API_KEY=

# Public Application URL (used for WhatsApp links)
APP_URL=

# Storage Directory for data persistence (defaults to project root)
STORAGE_DIR=

# Google Drive API OAuth credentials (optional for auto-refreshing tokens)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
